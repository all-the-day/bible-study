# 缓存与日志
cache/
*.log

# Python 缓存
__pycache__/
*.pyc

# 系统文件
.DS_Store
Thumbs.db

# 数据文件由 scripts/export.py 生成，不入库（体积大、可再生）
data/bible-text.json
data/bible-notes.json
data/bible-xrefs.json
data/bible-outlines.json
data/lifereading/
data/morning/
data/books/

# 本地密钥
.env
.env.local

# Vercel
.vercel/
.vercel

# Capacitor / Node（CI 生成，不入库）
node_modules/
www/
android/
!config/                # 原生插件源码目录需要入库（android/ 模式会连带命中 config/android/，需先解除父目录）
!config/android/
package-lock.json
builds/
.workbuddy/memory/

# 反馈收件箱本地快照（pull 生成，不入库）
scripts/feedback/inbox.md

# agent 产出图片统一放此目录（原型图/截图/AI 生成图），不入库
generated-images/

# 本地自测产物（截图/浏览器快照）
.shots/
.playwright-cli/
.tmp-shots/

# ui-review 评审过程产物（报告 + 页面截图），结论已随修复提交
.ui-review/

# 调试产物与工具本地配置
docs/*.har
.zcodeignore

# Ekko 工作流本地入口（任务描述，不入库）
.ekko/

# ZCode 本地流水线任务与计划（不入库）
.zcode/

# 专题产物（scripts/build-topics.py 生成，与其它 data/* 一样不入库）
data/topics/

# 听书元数据（scripts/export-audio.py 生成，音频本体在 OSS）
data/audio/
